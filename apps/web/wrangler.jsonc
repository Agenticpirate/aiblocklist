{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "aiblocklist-web",
	"workers_dev": true,
	"routes": [
		{ "pattern": "aiblocklist.com/*", "zone_name": "aiblocklist.com" },
		{ "pattern": "www.aiblocklist.com", "custom_domain": true }
	],
	"compatibility_date": "2026-11-24",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "aiblocklist-web"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aiblocklist-db",
			"database_id": "413c84c4-2ccc-4d96-aeed-6dda05086cd4"
		}
	],
	"vars": {
		"NEXT_PUBLIC_API_BASE_URL": "https://aiblocklist.com/api/v1",
		"INTERNAL_API_URL": "https://aiblocklist.com/api/v1"
	}
}