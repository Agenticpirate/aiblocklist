{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/terms/layout,_N_T_/terms/page,_N_T_/terms"},"routeCache":{"key":"/route-cache/APP_PAGE/0a918ac4324425973e0805850d87b0021894c2cb60005bfce00fc8b9b139266e/$/terms","owner":{"kind":"APP_PAGE","sourceRoute":"/terms/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--6_NegyQYjPmdjWkyM_ZOs--><html lang=\"en\" class=\"__variable_fee4ca __variable_9f1075 dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/2bcd4b1f8f3a3e9f.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/cf72403939ff961f-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Flogo.png&amp;w=32&amp;q=75 1x, /_next/image?url=%2Flogo.png&amp;w=64&amp;q=75 2x\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c3e48fc334585ec0.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-caa21fb8525f2992.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-73938ce8a8eac1ad.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-a08af2d55b863de3.js\" async=\"\"></script><script src=\"/_next/static/chunks/0-662476c4b7ee794e.js\" async=\"\"></script><script src=\"/_next/static/chunks/323-d01787c058f9b68c.js\" async=\"\"></script><script src=\"/_next/static/chunks/657-adfc2ab02f902b7e.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2532f188a257f1b0.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/terms/page-7d725ef59366d5fd.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Terms of Service &amp; Open Source Governance Charter — AIBlockList</title><meta name=\"description\" content=\"Official terms of service, governance charter, acceptable use policy, and licensing agreements governing AIBlockList.com public intelligence infrastructure.\"/><meta property=\"og:title\" content=\"AIBlockList — Identify. Verify. Filter.\"/><meta property=\"og:description\" content=\"Open source trust and safety infrastructure separating abusive automation from genuine human and AI assisted communication.\"/><meta property=\"og:image\" content=\"https://aiblocklist.com/logo.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"1200\"/><meta property=\"og:image:alt\" content=\"AIBlockList Logo\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"AIBlockList — Identify. Verify. Filter.\"/><meta name=\"twitter:description\" content=\"Open source trust and safety infrastructure separating abusive automation from genuine human and AI assisted communication.\"/><meta name=\"twitter:image\" content=\"https://aiblocklist.com/logo.png\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"1200\"/><meta name=\"twitter:image:alt\" content=\"AIBlockList Logo\"/><link rel=\"shortcut icon\" href=\"/favicon.ico\"/><link rel=\"icon\" href=\"/favicon.ico\" sizes=\"48x48\"/><link rel=\"icon\" href=\"/favicon-48.png\" sizes=\"48x48\" type=\"image/png\"/><link rel=\"icon\" href=\"/favicon.png\" sizes=\"32x32\" type=\"image/png\"/><link rel=\"icon\" href=\"/logo.png\" sizes=\"192x192\" type=\"image/png\"/><link rel=\"apple-touch-icon\" href=\"/logo.png\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-[#000000] text-zinc-100 antialiased selection:bg-[#ff6600] selection:text-black\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"sr-only focus