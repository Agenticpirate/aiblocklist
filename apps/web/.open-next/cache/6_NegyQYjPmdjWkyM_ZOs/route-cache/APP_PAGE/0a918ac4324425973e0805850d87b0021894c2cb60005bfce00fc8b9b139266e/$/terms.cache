ce-y-2 body-6 text-zinc-300 font-mono\",\"children\":[[\"$\",\"li\",null,{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[#ff6600] font-bold\",\"children\":\"1.\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Zero Pay-to-Delist:\"}],\" We never charge, accept, or solicit fees, donations, or compensation of any kind to review, expedite, or delist an account.\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[#ff6600] font-bold\",\"children\":\"2.\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Zero Data Monetization:\"}],\" We never sell private user telemetry, reporter identities, IP hash logs, or unverified claims to data brokers, ad networks, or commercial scrapers.\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[#ff6600] font-bold\",\"children\":\"3.\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Zero Stylometric AI Text Discrimination:\"}],\" We never list accounts based purely on probabilistic AI text detectors, protecting non-native English speakers from unjust algorithmic exclusion.\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[#ff6600] font-bold\",\"children\":\"4.\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Zero Secret Evidence:\"}],\" Every listed account must cite public, canonical behavioral URLs verifiable by any member of the public.\"]}]]}]]}]\na:[\"$\",\"div\",null,{\"className\":\"rounded-2xl border border-[#272727] bg-[#181818] p-6 sm:p-8 space-y-8 text-zinc-300 body-4\",\"children\":[[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"1. Acceptance of Terms\"}],[\"$\",\"p\",null,{\"children\":\"By accessing, reading, subscribing to, consuming via API, or utilizing browser extensions powered by AIBlockList (“the Service”), you agree to be bound by these Terms of Service. If you do not agree to these terms, you must discontinue use of the Service immediately.\"}]]}],[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"2. Open Source Licensing & Dataset Attribution\"}],[\"$\",\"p\",null,{\"children\":\"AIBlockList is built on open standards, public transparency, and open-source collaboration:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-1.5 body-6 text-zinc-400\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Software Code:\"}],\" The codebase (frontend web applications, FastAPI backend, federation scrapers, browser extensions) is licensed under the\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.apache.org/licenses/LICENSE-2.0\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-[#ff6600] hover:underline\",\"children\":\"Apache License 2.0\"}],\".\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Public Intelligence Dataset:\"}],\" Core verified dataset exports, policy manifests, and cryptographic audit logs are published under the\",\" \",[\"$\",\"a\",null,{\"href\":\"https://opendatacommons.org/licenses/by/1-0/\",\"target\":\"_blank\",\"rel\":\"noreferrer\",\"className\":\"text-[#ff6600] hover:underline\",\"children\":\"Open Data Commons Attribution License 1.0 (ODC-By 1.0)\"}],\".\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Upstream Project Attribution:\"}],\" External intelligence lists and pioneer AI-reply defense lists retain full attribution to their respective original curators.\"]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"3. Public Behavioral Observation Disclaimer\"}],[\"$\",\"p\",null,{\"children\":\"AIBlockList compiles and indexes observable, public social media behavioral patterns (such as high-velocity unsolicited replies, copy-paste templated loops, and coordinated sybil clusters) evaluated strictly against our versioned public policies.\"}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-[#272727] bg-[#0c0c0c] p-4 text-xs font-mono text-zinc-300\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white block mb-1 uppercase tracking-wider text-[#ff6600]\",\"children\":\"Legal Notice of Observation:\"}],\"A listing on AIBlockList is an editorial assessment of observable behavioral telemetry under published criteria. It does NOT constitute a statement of fact regarding the author's legal compliance, criminal liability, human biological identity, or violation of third-party platform terms.\"]}]]}],[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"4. Acceptable Use & Anti-Harassment Prohibition\"}],[\"$\",\"p\",null,{\"children\":\"The Service is provided strictly for personal feed filtering, automated spam defense, academic research, and transparent platform hygiene. You expressly agree that you will NOT:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-1.5 body-6 text-zinc-400\",\"children\":[[\"$\",\"li\",null,{\"children\":\"Use the database or extensions to organize, encourage, or facilitate targeted harassment, brigading, or mass-reporting campaigns against any individual.\"}],[\"$\",\"li\",null,{\"children\":\"Dox, publish private offline contact information, or threaten listed account holders.\"}],\"$Lf\",\"$L10\"]}]]}],\"$L11\",\"$L12\",\"$L13\"]}]\nb:[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[#272727]\",\"children\":[[\"$\",\"$L5\",null,{\"href\":\"/privacy\",\"className\":\"button-sm inline-flex items-center gap-1.5 text-zinc-400 hover:text-white\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"currentColor\",\"viewBox\":\"0 0 256 256\",\"transform\":\"$undefined\",\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"d\":\"M213.66,82.34l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V88A8,8,0,0,0,213.66,82.34ZM160,51.31,188.69,80H160ZM200,216H56V40h88V88a8,8,0,0,0,8,8h48V216Zm-32-80a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,136Zm0,32a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,168Z\"}]]}],[\"$\",\"span\",null,{\"children\":\"Read Privacy Notice\"}]]}],[\"$\",\"$L5\",null,{\"href\":\"/about\",\"className\":\"button-sm inline-flex items-center gap-1.5 text-[#ff6600] hover:text-white\",\"children\":[[\"$\",\"span\",null,{\"children\":\"About & Community Credits\"}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"currentColor\",\"viewBox\":\"0 0 256 256\",\"transform\":\"$undefined\",\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"d\":\"M224.49,136.49l-72,72a12,12,0,0,1-17-17L187,140H40a12,12,0,0,1,0-24H187L135.51,64.48a12,12,0,0,1,17-17l72,72A12,12,0,0,1,224.49,136.49Z\"}]]}]]}]]}]\nc:[\"$\",\"$L14\",null,{\"children\":[\"$L15\",[\"$\",\"$L16\",null,{\"promise\":\"$@17\"}]]}]\nd:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L18\",null,{\"children\":\"$L19\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L1a\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$1b\",null,{\"fallback\":null,\"children\":\"$L1c\"}]}]}]]}]\nf:[\"$\",\"li\",null,{\"children\":\"Attempt to circumvent public rate limits or disrupt service availability through Denial of Service (DoS) attacks.\"}]\n10:[\"$\",\"li\",null,{\"children\":\"Falsify behavioral evidence or submit fraudulent abuse complaints against political, ideological, or commercial competitors.\"}]\n11:[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"5. Independent Right to Appeal & Fast-Track Delisting\"}],[\"$\",\"p\",null,{\"children\":\"Any account holder listed in our database possesses the absolute, perpetual right to challenge their listing free of charge. We provide an automated bio challenge verification system that guarantees impartial re-review by an independent reviewer within 7 business days.\"}],[\"$\",\"p\",null,{\"children\":[\"To file an appeal, visit our dedicated portal at\",\" \",[\"$\",\"$L5\",null,{\"href\":\"/appeals\",\"className\":\"text-[#ff6600] hover:underline font-mono\",\"children\":\"/appeals\"}],\".\"]}]]}]\n12:[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"6. Disclaimer of Warranties & Limitation of Liability\"}],[\"$\",\"p\",null,{\"className\":\"caption-4 font-mono text-zinc-400 uppercase leading-relaxed\",\"children\":\"THE SERVICE AND DATASETS ARE PROVIDED “AS IS” AND “AS AVAILABLE” WITHOUT WARRANTY OF ANY KIND, WHETHER EXPRESS, IMPLIED, STATUTORY, OR OTHERWISE. TO THE MAXIMUM EXTENT PERMITTED UNDER APPLICABLE LAW, NEITHER AIBLOCKLIST, ITS CONTRIBUTORS, NOR ITS CURATORS SHALL BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES, INCLUDING BUT NOT LIMITED TO LOSS OF REPUTATION, ACCOUNT SUSPENSION BY THIRD-PARTY PLATFORMS, OR LOSS OF BUSINESS OPPORTUNITY.\"}]]}]\n13:[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"7. DMCA & Takedown Requests\"}],[\"$\",\"p\",null,{\"children\":[\"AIBlockList respects intellectual property and privacy rights. Because our system stores zero raw verbatim post text and zero screenshot media (storing only canonical status URLs and cryptographic SHA-256 hashes), content hosted on upstream platforms remains under the control of those platforms. For copyright or privacy takedown notices, contact our Trust & Safety desk via\",\" \",[\"$\",\"$L5\",null,{\"href\":\"/contact\",\"className\":\"text-[#ff6600] hover:underline\",\"children\":\"our Contact Portal\"}],\".\"]}]]}]\n19:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n15:null\n1d:I[622,[],\"IconMark\"]\n17:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Terms of Service & Open Source Governance Charter — AIBlockList\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Official terms of service, governance charter, acceptable use policy, and licensing agreements governing AIBlockList.com public intelligence infrastructure.\"}],[\"$\",\"meta\",\"2\",{\"property\":\"og:title\",\"content\":\"AIBlockList — Identify. Verify. Filter.\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:description\",\"content\":\"Open source trust and safety infrastructure separating abusive automation from genuine human and AI assisted communication.\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:image\",\"content\":\"https://aiblocklist.com/logo.png\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:image:height\",\"content\":\"1200\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image:alt\",\"content\":\"AIBlockList Logo\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"9\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twit