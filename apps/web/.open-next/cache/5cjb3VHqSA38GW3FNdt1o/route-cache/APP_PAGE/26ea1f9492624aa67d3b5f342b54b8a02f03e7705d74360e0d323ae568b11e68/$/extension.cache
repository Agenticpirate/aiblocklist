{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/extension/layout,_N_T_/extension/page,_N_T_/extension"},"routeCache":{"key":"/route-cache/APP_PAGE/26ea1f9492624aa67d3b5f342b54b8a02f03e7705d74360e0d323ae568b11e68/$/extension","owner":{"kind":"APP_PAGE","sourceRoute":"/extension/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--5cjb3VHqSA38GW3FNdt1o--><html lang=\"en\" class=\"__variable_fee4ca __variable_9f1075 dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/2bcd4b1f8f3a3e9f.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/cf72403939ff961f-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Flogo.png&amp;w=32&amp;q=75 1x, /_next/image?url=%2Flogo.png&amp;w=64&amp;q=75 2x\"/><link rel=\"stylesheet\" href=\"/_next/static/css/551838da5dc18c99.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-caa21fb8525f2992.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-73938ce8a8eac1ad.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-a08af2d55b863de3.js\" async=\"\"></script><script src=\"/_next/static/chunks/0-662476c4b7ee794e.js\" async=\"\"></script><script src=\"/_next/static/chunks/600-ccfd0d87ccdd9828.js\" async=\"\"></script><script src=\"/_next/static/chunks/934-0b94999bf326ee8d.js\" async=\"\"></script><script src=\"/_next/static/chunks/808-c0d1165fc7a8b3b4.js\" async=\"\"></script><script src=\"/_next/static/chunks/657-1fea3f252cf06f5f.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-8de80b524eec9847.js\" async=\"\"></script><script src=\"/_next/static/chunks/917-8921ea5818dd745c.js\" async=\"\"></script><script src=\"/_next/static/chunks/733-5f82b5b531e0aada.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-792f6ec23aa5bb66.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Browser Extension (Manifest V3) — AIBlockList</title><meta name=\"description\" content=\"Local-first browser extension for Chrome, Brave, Edge, and Firefox. Flags automated spam bots in real time on X and Threads.\"/><meta property=\"og:title\" content=\"AIBlockList — Identify. Verify. Filter.\"/><meta property=\"og:description\" content=\"Open source trust and safety infrastructure separating abusive automation from genuine human and AI assisted communication.\"/><meta property=\"og:image\" content=\"https://aiblocklist.com/logo.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"1200\"/><meta property=\"og:image:alt\" content=\"AIBlockList Logo\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"AIBlockList — Identify. Verify. Filter.\"/><meta name=\"twitter:description\" content=\"Open source trust and safety infrastructure separating abusive automation from genuine human and AI assisted communication.\"/><meta name=\"twitter:image\" content=\"https://aiblocklist.com/logo.png\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"1200\"/><meta name=\"twitter:image:alt\" content=\"AIBlockList Logo\"/><link rel=\"icon\" href=\"/favicon.png\" sizes=\"32x32\" type=\"image/png\"/><link rel=\"icon\" href=\"/logo.png\" sizes=\"192x192\" type=\"image/png\"/><link rel=\"apple-touch-icon\" href=\"/logo.png\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-[#000000] text-zinc-100 antialiased selection:bg-[#ff6600] selection:text-