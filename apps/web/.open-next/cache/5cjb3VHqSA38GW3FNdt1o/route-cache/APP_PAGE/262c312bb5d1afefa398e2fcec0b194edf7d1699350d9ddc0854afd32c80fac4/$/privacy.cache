-8\",\"children\":\"If you searched for a social media handle, a missing record never implies that an account is legitimate or abusive. Use the directory to search indexed records.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center justify-center gap-3\",\"children\":[[\"$\",\"$L5\",null,{\"href\":\"/\",\"className\":\"button-md inline-flex items-center gap-2 rounded-lg border border-[#313131] bg-[#1f1f1f] px-3 py-2 text-white hover:bg-[#272727] transition-colors duration-300\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"currentColor\",\"viewBox\":\"0 0 256 256\",\"transform\":\"$undefined\",\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"d\":\"M228,128a12,12,0,0,1-12,12H69l51.52,51.51a12,12,0,0,1-17,17l-72-72a12,12,0,0,1,0-17l72-72a12,12,0,0,1,17,17L69,116H216A12,12,0,0,1,228,128Z\"}]]}],[\"$\",\"span\",null,{\"children\":\"Back to home\"}]]}],[\"$\",\"$L5\",null,{\"href\":\"/directory\",\"className\":\"button-md inline-flex items-center gap-2 rounded-lg bg-[#ff6600] px-3 py-2 text-black hover:bg-[#e55c00] transition-colors duration-300\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"currentColor\",\"viewBox\":\"0 0 256 256\",\"transform\":\"$undefined\",\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"d\":\"M232.49,215.51,185,168a92.12,92.12,0,1,0-17,17l47.53,47.54a12,12,0,0,0,17-17ZM44,112a68,68,0,1,1,68,68A68.07,68.07,0,0,1,44,112Z\"}]]}],[\"$\",\"span\",null,{\"children\":\"Search directory\"}]]}]]}]]}]}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}],[\"$\",\"$L6\",null,{}]]}]}]]}],{\"children\":[\"privacy\",[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L4\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[\"__PAGE__\",[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8 space-y-10\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-3 inline-flex items-center gap-2 rounded-full border border-[#272727] bg-[#181818] px-3 py-1\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-2 w-2 rounded-full bg-[#ff6600]\"}],[\"$\",\"span\",null,{\"className\":\"caption-4 font-mono text-zinc-300\",\"children\":[\"Privacy by Architecture · Effective \",\"November 24, 2026\"]}]]}],[\"$\",\"h1\",null,{\"className\":\"heading-2 text-white\",\"children\":\"Privacy Policy & Data Rights\"}],[\"$\",\"p\",null,{\"className\":\"body-3 mt-3 text-zinc-400\",\"children\":\"Our core premise: privacy is not an afterthought or a disclaimer—it is engineered directly into our system architecture, schema constraints, and client extensions.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl border border-[#272727] bg-[#181818] p-6 sm:p-8 space-y-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 text-[#ff6600]\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":22,\"height\":22,\"fill\":\"currentColor\",\"viewBox\":\"0 0 256 256\",\"transform\":\"$undefined\",\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"d\":\"M208,76H180V56A52,52,0,0,0,76,56V76H48A20,20,0,0,0,28,96V208a20,20,0,0,0,20,20H208a20,20,0,0,0,20-20V96A20,20,0,0,0,208,76ZM100,56a28,28,0,0,1,56,0V76H100ZM204,204H52V100H204Zm-76-92a32,32,0,0,0-12,61.66V180a12,12,0,0,0,24,0v-6.34A32,32,0,0,0,128,112Zm0,24a8,8,0,1,1-8,8A8,8,0,0,1,128,136Z\"}]]}],\"$L7\"]}],\"$L8\"]}],\"$L9\",\"$La\"]}],null,\"$Lb\"]}],{},null,false]},null,false]},null,false],\"$Lc\",false]],\"m\":\"$undefined\",\"G\":[\"$d\",[]],\"s\":false,\"S\":true}\n10:I[4431,[],\"OutletBoundary\"]\n12:I[5278,[],\"AsyncMetadataOutlet\"]\n14:I[4431,[],\"ViewportBoundary\"]\n16:I[4431,[],\"MetadataBoundary\"]\n17:\"$Sreact.suspense\"\n7:[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"Privacy in Three Rules\"}]\n8:[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 gap-4 sm:grid-cols-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-[#272727] bg-[#0c0c0c] p-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"caption-4 font-mono uppercase text-[#ff6600] block mb-1\",\"children\":\"Zero Raw Post Scraping\"}],[\"$\",\"p\",null,{\"className\":\"caption-5 text-zinc-400\",\"children\":\"We never archive full social media post archives or private DMs. Only canonical public URLs and cryptographic hashes are persisted.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-[#272727] bg-[#0c0c0c] p-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"caption-4 font-mono uppercase text-[#ff6600] block mb-1\",\"children\":\"Zero Browser Tracking\"}],[\"$\",\"p\",null,{\"className\":\"caption-5 text-zinc-400\",\"children\":\"Our browser extension evaluates handles in local memory against an offline cache. Your browsing feeds and reading habits are never transmitted.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-[#272727] bg-[#0c0c0c] p-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"caption-4 font-mono uppercase text-[#ff6600] block mb-1\",\"children\":\"Zero Tracking Cookies\"}],[\"$\",\"p\",null,{\"className\":\"caption-5 text-zinc-400\",\"children\":\"We employ no Google Analytics, no Facebook pixels, and no ad trackers. Local browser storage is used exclusively for theme and filter settings.\"}]]}]]}]\n9:[\"$\",\"div\",null,{\"className\":\"rounded-2xl border border-[#272727] bg-[#181818] p-6 sm:p-8 space-y-8 text-zinc-300 body-4\",\"children\":[[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"1. Data Controller & Scope\"}],[\"$\",\"p\",null,{\"children\":\"This Privacy Policy governs AIBlockList.com (“AIBlockList”, “we”, or “our”), an open-source public interest intelligence project. This policy details how we collect, process, and safeguard information across our web applications, public API endpoints, and client extensions.\"}]]}],[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"2. Categories of Information Processed\"}],[\"$\",\"p\",null,{\"children\":\"We adhere strictly to the principle of data minimization:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-2 body-6 text-zinc-400\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Public Behavioral Observations:\"}],\" Numeric platform account IDs, public usernames, canonical post permalinks, behavioral signal scores (SIG-01 through SIG-05), and SHA-256 integrity hashes.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"API Abuse Prevention Telemetry:\"}],\" To defend against Denial of Service (DoS) and abusive automated scraping, incoming requests log a salted, one-way SHA-256 hash of the caller's /24 IPv4 or /48 IPv6 network subnet. Raw IP addresses are discarded in volatile memory and never written to persistent storage. Subnet hashes expire automatically after 30 days.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Community Abuse Reports:\"}],\" When users submit reports via our form, we collect only public post URLs, observed behavioral tags, and the optional reporter handle.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Appeals Data:\"}],\" Ephemeral bio verification challenge tokens generated during appeals expire automatically within 48 hours of verification completion.\"]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"3. Public vs. Private Schema Isolation\"}],[\"$\",\"p\",null,{\"children\":\"By architectural design, internal operational records are strictly segregated from public datasets:\"}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-[#272727] bg-[#0c0c0c] p-4 text-xs font-mono text-zinc-300 space-y-1\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-[#ff6600]\",\"children\":\"Public Intelligence Exports:\"}],\" Handle, Platform ID, Canonical URLs, Hashes, Provenance Source, Review Status.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-400\",\"children\":\"Private Isolated Schemas:\"}],\" Reporter IP subnet hashes (30d TTL), Internal moderator deliberations, Ephemeral appeal tokens.\"]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"4. Lawful Basis for Processing (GDPR & DPDP)\"}],[\"$\",\"p\",null,{\"children\":\"For users residing in the European Economic Area (EEA), the United Kingdom, or India:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-1.5 body-6 text-zinc-400\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Legitimate Interests (GDPR Art. 6(1)(f)):\"}],\" Processing public telemetry is strictly necessary for our legitimate interest in protecting internet users against automated sybil spam, social engineering botnets, and coordinated platform manipulation.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Freedom of Expression & Research:\"}],\" Operating public accountability registers regarding automated bot activity on public communication networks.\"]}]]}]]}],\"$Le\",\"$Lf\"]}]\na:[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[#272727]\",\"children\":[[\"$\",\"$L5\",null,{\"href\":\"/terms\",\"className\":\"button-sm inline-flex items-center gap-1.5 text-zinc-400 hover:text-white\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"currentColor\",\"viewBox\":\"0 0 256 256\",\"transform\":\"$undefined\",\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"d\":\"M213.66,82.34l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V88A8,8,0,0,0,213.66,82.34ZM160,51.31,188.69,80H160ZM200,216H56V40h88V88a8,8,0,0,0,8,8h48V216Zm-32-80a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,136Zm0,32a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,168Z\"}]]}],[\"$\",\"span\",null,{\"children\":\"Terms of Service\"}]]}],[\"$\",\"$L5\",null,{\"href\":\"/transparency\",\"className\":\"button-sm inline-flex items-center gap-1.5 text-[#ff6600] hover:text-white\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"currentColor\",\"viewBox\":\"0 0 256 256\",\"transform\":\"$undefined\",\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"d\":\"M128,24C74.17,24,32,48.6,32,80v96c0,31.4,42.17,56,96,56s96-24.6,96-56V80C224,48.6,181.83,24,128,24Zm80,104c0,9.62-7.88,19.43-21.61,26.92C170.93,163.35,150.19,168,128,168s-42.93-4.65-58.39-13.08C55.88,147.43,48,137.62,48,128V111.36c17.06,15,46.23,24.64,80,24.64s62.94-9.68,80-24.64ZM69.61,53.08C85.07,44.65,105.81,40,128,40s42.93,4.65,58.39,13.08C200.12,60.57,208,70.38,208,80s-7.88,19.43-21.61,26.92C170.93,115.35,150.19,120,128,120s-42.93-4.65-58.39-13.08C55.88,99.43,48,89.62,48,80S55.88,60.57,69.61,53.08ZM186.39,202.92C170.93,211.35,150.19,216,128,216s-42.93-4.65-58.39-13.08C55.88,195.43,48,185.62,48,176V159.36c17.06,15,46.23,24.64,80,24.64s62.94-9.68,80-24.64V176C208,185.62,200.12,195.43,186.39,202.92Z\"}]]}],[\"$\",\"span\",null,{\"children\":\"Cryptographic Audit Chain\"}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"currentColor\",\"viewBox\":\"0 0 256 256\",\"transform\":\"$undefined\",\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"d\":\"M224.49,136.49l-72,72a12,12,0,0,1-17-17L187,140H40a12,12,0,0,1,0-24H187L135.51,64.48a12,12,0,0,1,17-17l72,72A12,12,0,0,1,224.49,136.49Z\"}]]}]]}]]}]\nb:[\"$\",\"$L10\",null,{\"children\":[\"$L11\",[\"$\",\"$L12\",null,{\"promise\":\"$@13\"}]]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L14\",null,{\"children\":\"$L15\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L16\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$17\",null,{\"fallback\":null,\"children\":\"$L18\"}]}]}]]}]\ne:[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"5. Your Legal Rights: Erasure, Rectification & Delisting\"}],[\"$\",\"p\",null,{\"children\":\"We provide fast-track mechanisms to exercise your rights under GDPR (Articles 15 through 22), the California Consumer Privacy Act (CCPA), and India DPDP Act 2023:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-2 body-6 text-zinc-400\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Right to Erasure (Article 17):\"}],\" If an upstream post is deleted on X or Threads, our periodic sync applies an immutable tombstone (`source_deleted_at`), removing it from public view.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Right to Object & Free Delisting (Article 21):\"}],\" If you believe your account was erroneously classified, you may initiate an immediate, free independent appeal through our\",\" \",[\"$\",\"$L5\",null,{\"href\":\"/appeals\",\"className\":\"text-[#ff6600] hover:underline font-mono\",\"children\":\"Appeals Portal\"}],\".\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Anti-Harassment Cooldown:\"}],\" When an account is cleared or delisted upon appeal, our system applies a mandatory 90-day anti-harassment cooldown, preventing malicious actors from re-reporting the user without new independent verified evidence.\"]}]]}]]}]\nf:[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"6. Contact Data Protection Officer (DPO)\"}],[\"$\",\"p\",null,{\"children\":[\"For privacy inquiries, regulatory notices, or formal data subject access requests, reach our designated Trust & Safety custodians via\",\" \",[\"$\",\"$L5\",null,{\"href\":\"/contact\",\"className\":\"text-[#ff6600] hover:underline\",\"children\":\"our Contact & Governance Center\"}],\".\"]}]]}]\n15:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n11:null\n19:I[622,[],\"IconMark\"]\n13:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Privacy Notice & Data Governance — AIBlockList\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Privacy by Architecture: Understand how AIBlockList processes data, protects user privacy, eliminates tracking cookies, and upholds global data rights.\"}],[\"$\",\"meta\",\"2\",{\"property\":\"og:title\",\"content\":\"AIBlockList — Identify. Verify. Filter.\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:description\",\"content\":\"Open source trust and safety infrastructure separating abusive automation from genuine h