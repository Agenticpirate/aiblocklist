c=\"/_next/static/chunks/523-28624bffe5e3f9d4.js\" async=\"\"></script><script src=\"/_next/static/chunks/733-3a78ab162d7e38a6.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-6eb3df789e370903.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>AIBlockList — Open Source Behavioral Trust and Safety Infrastructure</title><meta name=\"description\" content=\"Identify, verify, and filter abusive automated social media spam using public behavioral evidence, human dual review, and free independent appeals.\"/><meta property=\"og:title\" content=\"AIBlockList — Identify. Verify. Filter.\"/><meta property=\"og:description\" content=\"Open source trust and safety infrastructure separating abusive automation from genuine human and AI assisted communication.\"/><meta property=\"og:image\" content=\"https://aiblocklist.com/logo.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"1200\"/><meta property=\"og:image:alt\" content=\"AIBlockList Logo\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"AIBlockList — Identify. Verify. Filter.\"/><meta name=\"twitter:description\" content=\"Open source trust and safety infrastructure separating abusive automation from genuine human and AI assisted communication.\"/><meta name=\"twitter:image\" content=\"https://aiblocklist.com/logo.png\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"1200\"/><meta name=\"twitter:image:alt\" content=\"AIBlockList Logo\"/><link rel=\"shortcut icon\" href=\"/favicon.ico\"/><link rel=\"icon\" href=\"/favicon.ico\" sizes=\"48x48\"/><link rel=\"icon\" href=\"/favicon-48.png\" sizes=\"48x48\" type=\"image/png\"/><link rel=\"icon\" href=\"/favicon.png\" sizes=\"32x32\" type=\"image/png\"/><link rel=\"icon\" href=\"/logo.png\" sizes=\"192x192\" type=\"image/png\"/><l