\\\"rounded-xl border border-[#272727] bg-[#0c0c0c] p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"caption-4 font-mono uppercase text-[#ff6600] block mb-1\\\",\\\"children\\\":\\\"Zero Tracking Cookies\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"caption-5 text-zinc-400\\\",\\\"children\\\":\\\"We employ no Google Analytics, no Facebook pixels, and no ad trackers. Local browser storage is used exclusively for theme and filter settings.\\\"}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"a:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-2xl border border-[#272727] bg-[#181818] p-4 sm:p-8 space-y-5 sm:space-y-8 text-zinc-300 body-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"title-2 text-white\\\",\\\"children\\\":\\\"1. Data Controller \\u0026 Scope\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"This Privacy Policy governs AIBlockList.com (“AIBlockList”, “we”, or “our”), an open-source public interest intelligence project. This policy details how we collect, process, and safeguard information across our web applications, public API endpoints, and client extensions.\\\"}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"title-2 text-white\\\",\\\"children\\\":\\\"2. Categories of Information Processed\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"We adhere strictly to the principle of data minimization:\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"list-disc pl-5 space-y-2 body-6 text-zinc-400\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-zinc-200\\\",\\\"children\\\":\\\"Public Behavioral Observations:\\\"}],\\\" Numeric platform account IDs, public usernames, canonical post permalinks, behavioral signal scores (SIG-01 through SIG-05), and SHA-256 integrity hashes.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-zinc-200\\\",\\\"children\\\":\\\"API Abuse Prevention Telemetry:\\\"}],\\\" To defend against Denial of Service (DoS) and abusive automated scraping, incoming requests log a salted, one-way SHA-256 hash of the caller's /24 IPv4 or /48 IPv6 network subnet. Raw IP addresses are discarded in volatile memory and never written to persistent storage. Subnet hashes expire automatically after 30 days.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-zinc-200\\\",\\\"children\\\":\\\"Community Abuse Reports:\\\"}],\\\" When users submit reports via our form, we collect only public post URLs, observed behavioral tags, and the optional reporter handle.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-zinc-200\\\",\\\"children\\\":\\\"Appeals Data:\\\"}],\\\" Ephemeral bio verification challenge tokens generated during appeals expire automatically within 48 hours of verification completion.\\\"]}]]}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"title-2 text-white\\\",\\\"children\\\":\\\"3. Public vs. Private Schema Isolation\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"By architectural design, internal operational records are strictly segregated from public datasets:\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-xl border border-[#272727] bg-[#0c0c0c] p-4 text-xs font-mono text-zinc-300 space-y-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-[#ff6600]\\\",\\\"children\\\":\\\"Public Intelligence Exports:\\\"}],\\\" Handle, Platform ID, Canonical URLs, Hashes, Provenance Source, Review Status.\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-zinc-400\\\",\\\"children\\\":\\\"Private Isolated Schemas:\\\"}],\\\" Reporter IP subnet hashes (30d TTL), Internal moderator deliberations, Ephemeral appeal tokens.\\\"]}]]}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"title-2 text-white\\\",\\\"children\\\":\\\"4. Lawful Basis for Processing (GDPR \\u0026 DPDP)\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"For users residing in the European Economic Area (EEA), the United Kingdom, or India:\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"list-disc pl-5 space-y-1.5 body-6 text-zinc-400\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-zinc-200\\\",\\\"children\\\":\\\"Legitimate Interests (GDPR Art. 6(1)(f)):\\\"}],\\\" Processing public telemetry is strictly necessary for our legitimate interest in protecting internet users against automated sybil spam, social engineering botnets, and coordinated platform manipulation.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-zinc-200\\\",\\\"children\\\":\\\"Freedom of Expression \\u0026 Research:\\\"}],\\\" Operating public accountability registers regarding automated bot activity on public communication networks.\\\"]}]]}]]}],\\\"$Lf\\\",\\\"$L10\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[#272727]\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/terms\\\",\\\"className\\\":\\\"button-sm inline-flex items-center gap-1.5 text-zinc-400 hover:text-white\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\