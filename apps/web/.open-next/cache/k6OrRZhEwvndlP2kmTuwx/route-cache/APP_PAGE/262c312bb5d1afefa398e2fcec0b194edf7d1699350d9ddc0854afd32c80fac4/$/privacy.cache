08,76ZM100,56a28,28,0,0,1,56,0V76H100ZM204,204H52V100H204Zm-76-92a32,32,0,0,0-12,61.66V180a12,12,0,0,0,24,0v-6.34A32,32,0,0,0,128,112Zm0,24a8,8,0,1,1-8,8A8,8,0,0,1,128,136Z\"}]\n8:[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"Privacy in Three Rules\"}]\n9:[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 gap-4 sm:grid-cols-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-[#272727] bg-[#0c0c0c] p-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"caption-4 font-mono uppercase text-[#ff6600] block mb-1\",\"children\":\"Zero Raw Post Scraping\"}],[\"$\",\"p\",null,{\"className\":\"caption-5 text-zinc-400\",\"children\":\"We never archive full social media post archives or private DMs. Only canonical public URLs and cryptographic hashes are persisted.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-[#272727] bg-[#0c0c0c] p-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"caption-4 font-mono uppercase text-[#ff6600] block mb-1\",\"children\":\"Zero Browser Tracking\"}],[\"$\",\"p\",null,{\"className\":\"caption-5 text-zinc-400\",\"children\":\"Our browser extension evaluates handles in local memory against an offline cache. Your browsing feeds and reading habits are never transmitted.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-[#272727] bg-[#0c0c0c] p-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"caption-4 font-mono uppercase text-[#ff6600] block mb-1\",\"children\":\"Zero Tracking Cookies\"}],[\"$\",\"p\",null,{\"className\":\"caption-5 text-zinc-400\",\"children\":\"We employ no Google Analytics, no Facebook pixels, and no ad trackers. Local browser storage is used exclusively for theme and filter settings.\"}]]}]]}]\na:[\"$\",\"div\",null,{\"className\":\"rounded-2xl border border-[#272727] bg-[#181818] p-4 sm:p-8 space-y-5 sm:space-y-8 text-zinc-300 body-4\",\"children\":[[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"1. Data Controller & Scope\"}],[\"$\",\"p\",null,{\"children\":\"This Privacy Policy governs AIBlockList.com (“AIBlockList”, “we”, or “our”), an open-source public interest intelligence project. This policy details how we collect, process, and safeguard information across our web applications, public API endpoints, and client extensions.\"}]]}],[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"2. Categories of Information Processed\"}],[\"$\",\"p\",null,{\"children\":\"We adhere strictly to the principle of data minimization:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-2 body-6 text-zinc-400\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Public Behavioral Observations:\"}],\" Numeric platform account IDs, public usernames, canonical post permalinks, behavioral signal scores (SIG-01 through SIG-05), and SHA-256 integrity hashes.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"API Abuse Prevention Telemetry:\"}],\" To defend against Denial of Service (DoS) and abusive automated scraping, incoming requests log a salted, one-way SHA-256 hash of the caller's /24 IPv4 or /48 IPv6 network subnet. Raw IP addresses are discarded in volatile memory and never written to persistent storage. Subnet hashes expire automatically after 30 days.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Community Abuse Reports:\"}],\" When users submit reports via our form, we collect only public post URLs, observed behavioral tags, and the optional reporter handle.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Appeals Data:\"}],\" Ephemeral bio verification challenge tokens generated during appeals expire automatically within 48 hours of verification completion.\"]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"3. Public vs. Private Schema Isolation\"}],[\"$\",\"p\",null,{\"children\":\"By architectural design, internal operational records are strictly segregated from public datasets:\"}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-[#272727] bg-[#0c0c0c] p-4 text-xs font-mono text-zinc-300 space-y-1\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-[#ff6600]\",\"children\":\"Public Intelligence Exports:\"}],\" Handle, Platform ID, Canonical URLs, Hashes, Provenance Source, Review Status.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-400\",\"children\":\"Private Isolated Schemas:\"}],\" Reporter IP subnet hashes (30d TTL), Internal moderator deliberations, Ephemeral appeal tokens.\"]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"4. Lawful Basis for Processing (GDPR & DPDP)\"}],[\"$\",\"p\",null,{\"children\":\"For users residing in the European Economic Area (EEA), the United Kingdom, or India:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-1.5 body-6 text-zinc-400\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Legitimate Interests (GDPR Art. 6(1)(f)):\"}],\" Processing public telemetry is strictly necessary for our legitimate interest in protecting internet users against automated sybil spam, social engineering botnets, and coordinated platform manipulation.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Freedom of Expression & Research:\"}],\" Operating public accountability registers regarding automated bot activity on public communication networks.\"]}]]}]]}],\"$Lf\",\"$L10\"]}]\nb:[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[#272727]\",\"children\":[[\"$\",\"$L5\",null,{\"href\":\"/terms\",\"className\":\"button-sm inline-flex items-center gap-1.5 text-zinc-400 hover:text-white\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"currentColor\",\"viewBox\":\"0 0 256 256\",\"transform\":\"$undefined\",\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"d\":\"M213.66,82.34l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V88A8,8,0,0,0,213.66,82.34ZM160,51.31,188.69,80H160ZM200,216H56V40h88V88a8,8,0,0,0,8,8h48V216Zm-32-80a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,136Zm0,32a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,168Z\"}]]}],[\"$\",\"span\",null,{\"children\":\"Terms of Service\"}]]}],[\"$\",\"$L5\",null,{\"href\":\"/transparency\",\"className\":\"button-sm inline-flex items-center gap-1.5 text-[#ff6600] hover:text-white\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"currentColor\",\"viewBox\":\"0 0 256 256\",\"transform\":\"$undefined\",\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"d\":\"M128,24C74.17,24,32,48.6,32,80v96c0,31.4,42.17,56,96,56s96-24.6,96-56V80C224,48.6,181.83,24,128,24Zm80,104c0,9.62-7.88,19.43-21.61,26.92C170.93,163.35,150.19,168,128,168s-42.93-4.65-58.39-13.08C55.88,147.43,48,137.62,48,128V111.36c17.06,15,46.23,24.64,80,24.64s62.94-9.68,80-24.64ZM69.61,53.08C85.07,44.65,105.81,40,128,40s42.93,4.65,58.39,13.08C200.12,60.57,208,70.38,208,80s-7.88,19.43-21.61,26.92C170.93,115.35,150.19,120,128,120s-42.93-4.65-58.39-13.08C55.88,99.43,48,89.62,48,80S55.88,60.57,69.61,53.08ZM186.39,202.92C170.93,211.35,150.19,216,128,216s-42.93-4.65-58.39-13.08C55.88,195.43,48,185.62,48,176V159.36c17.06,15,46.23,24.64,80,24.64s62.94-9.68,80-24.64V176C208,185.62,200.12,195.43,186.39,202.92Z\"}]]}],[\"$\",\"span\",null,{\"children\":\"Cryptographic Audit Chain\"}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"currentColor\",\"viewBox\":\"0 0 256 256\",\"transform\":\"$undefined\",\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"d\":\"M224.49,136.49l-72,72a12,12,0,0,1-17-17L187,140H40a12,12,0,0,1,0-24H187L135.51,64.48a12,12,0,0,1,17-17l72,72A12,12,0,0,1,224.49,136.49Z\"}]]}]]}]]}]\nc:[\"$\",\"$L11\",null,{\"children\":[\"$L12\",[\"$\",\"$L13\",null,{\"promise\":\"$@14\"}]]}]\nd:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L15\",null,{\"children\":\"$L16\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L17\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$18\",null,{\"fallback\":null,\"children\":\"$L19\"}]}]}]]}]\nf:[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"5. Your Legal Rights: Erasure, Rectification & Delisting\"}],[\"$\",\"p\",null,{\"children\":\"We provide fast-track mechanisms to exercise your rights under GDPR (Articles 15 through 22), the California Consumer Privacy Act (CCPA), and India DPDP Act 2023:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-2 body-6 text-zinc-400\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Right to Erasure (Article 17):\"}],\" If an upstream post is deleted on X or Threads, our periodic sync applies an immutable tombstone (`source_deleted_at`), removing it from public view.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Right to Object & Free Delisting (Article 21):\"}],\" If you believe your account was erroneously classified, you may initiate an immediate, free independent appeal through our\",\" \",[\"$\",\"$L5\",null,{\"href\":\"/appeals\",\"className\":\"text-[#ff6600] hover:underline font-mono\",\"children\":\"Appeals Portal\"}],\".\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-zinc-200\",\"children\":\"Anti-Harassment Cooldown:\"}],\" When an account is cleared or delisted upon appeal, our system applies a mandatory 90-day anti-harassment cooldown, preventing malicious actors from re-reporting the user without new independent verified evidence.\"]}]]}]]}]\n10:[\"$\",\"section\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"title-2 text-white\",\"children\":\"6. Contact Data Protection Officer (DPO)\"}],[\"$\",\"p\",null,{\"children\":[\"For privacy inquiries, regulatory notices, or formal data subject access requests, reach our designated Trust & Safety custodians via\",\" \",[\"$\",\"$L5\",null,{\"href\":\"/contact\",\"className\":\"text-[#ff6600] hover:underline\",\"children\":\"our Contact & Governance Center\"}],\".\"]}]]}]\n16:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n12:null\n1a:I[622,[],\"IconMark\"]\n14:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Privacy Notice & Data Governance — AIBlockList\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Privacy by Architecture: Understand how AIBlockList processes data, protects user privacy, eliminates tracking cookies, and upholds global data rights.\"}],[\"$\",\"meta\",\"2\",{\"property\":\"og:title\",\"content\":\"AIBlockList — Identify. Verify. Filter.\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:description\",\"content\":\"Open source trust and safety infrastructure separating abusive automation from genuine human and AI assisted communication.\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:image\",\"content\":\"https://aiblocklist.com/logo.png\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:image:height\",\"content\":\"1200\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image:alt\",\"content\":\"AIBlockList Logo\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"9\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:title\",\"content\":\"AIBlockList — Identify. Verify. Filter.\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:description\",\"content\":\"Open source trust and safety infrastructure separating abusive automation from genuine human and AI assisted communication.\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:image\",\"content\":\"https://aiblocklist.com/logo.png\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:image:height\",\"content\":\"1200\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:image:alt\",\"content\":\"AIBlockList Logo\"}],[\"$\",\"link\",\"16\",{\"rel\":\"shortcut icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"17\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"sizes\":\"48x48\"}],[\"$\",\"link\",\"18\",{\"rel\":\"icon\",\"href\":\"/favicon-48.png\",\"sizes\":\"48x48\",\"type\":\"image/png\"}],[\"$\",\"link\",\"19\",{\"rel\":\"icon\",\"href\":\"/favicon.png\",\"sizes\":\"32x32\",\"type\":\"image/png\"}],[\"$\",\"link\",\"20\",{\"rel\":\"icon\",\"href\":\"/logo.png\",\"sizes\":\"192x192\",\"type\":\"image/png\"}],[\"$\",\"link\",\"21\",{\"rel\":\"apple-touch-icon\",\"href\":\"/logo.png\"}],[\"$\",\"$L1a\",\"22\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n19:\"$14:metadata\"\n"}