{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/extension/layout,_N_T_/extension/page,_N_T_/extension"},"routeCache":{"key":"/route-cache/APP_PAGE/26ea1f9492624aa67d3b5f342b54b8a02f03e7705d74360e0d323ae568b11e68/$/extension","owner":{"kind":"APP_PAGE","sourceRoute":"/extension/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--49HtxSGXVq_OULCQGPTbr--><html lang=\"en\" class=\"__variable_fee4ca __variable_9f1075 dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/2bcd4b1f8f3a3e9f.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/cf72403939ff961f-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Flogo.png&amp;w=32&amp;q=75 1x, /_next/image?url=%2Flogo.png&amp;w=64&amp;q=75 2x\"/><link rel=\"stylesheet\" href=\"/_next/static/css/3845cbc34f6d19a3.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-caa21fb8525f2992.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-73938ce8a8eac1ad.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-a08af2d55b863de3.js\" async=\"\"></script><script src=\"/_next/static/chunks/0-662476c4b7ee794e.js\" async=\"\"></script><script src=\"/_next/static/chunks/253-6a139add87fbaa88.js\" async=\"\"></script><script src=\"/_next/static/chunks/717-d6bf810a5cd1a3d1.js\" async=\"\"></script><script src=\"/_next/static/chunks/657-14cbe04f9a2d3004.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-564d920caf909cbd.js\" async=\"\"></script><script src=\"/_next/static/chunks/464-27b2f7fa04ae6154.js\" async=\"\"></script><script src=\"/_next/static/chunks/523-28624bffe5e3f9d4.js\" async=\"\"></script><script src=\"/_next/static/chunks/733-3a78ab162d7e38a6.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-6eb3df789e370903.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Browser Extension (Manifest V3) — AIBlockList</title><meta name=\"description\" content=\"Local-first browser extension for Chrome, Brave, Edge, and Firefox. Flags automated spam bots in real time on X and Threads.\"/><meta property=\"og:title\" content=\"AIBlockList — Identify. Verify. Filter.\"/><meta property=\"og:description\" content=\"Open source trust and safety infrastructure separating abusive automation from genuine human and AI assisted communication.\"/><meta property=\"og:image\" content=\"https://aiblocklist.com/logo.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"1200\"/><meta property=\"og:image:alt\" content=\"AIBlockList Logo\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"AIBlockList — Identify. Verify. Filter.\"/><meta name=\"twitter:description\" content=\"Open source trust and safety infrastructure separating abusive automation from genuine human and AI assisted communication.\"/><meta name=\"twitter:image\" content=\"https://aiblocklist.com/logo.png\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"1200\"/><meta name=\"twitter:image:alt\" content=\"AIBlockList Logo\"/><link rel=\"shortcut icon\" href=\"/favicon.ico\"/><link rel=\"icon\" href=\"/favicon.ico\" sizes=\"48x48\"/><link rel=\"icon\" href=\"/favicon-48.png\" sizes=\"48x48\" type=\"image/png\"/><link rel=\"icon\" href=\"/favicon.png\" sizes=\"32x32\" type=\"image/png\"/><link rel=\"icon\" href=\"/logo.png\" sizes=\"192x192\" type=\"image/png\"/><link rel=\"apple-touch-icon\" href=\"/logo.png\"/><script src=