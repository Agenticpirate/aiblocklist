ut\"><span>About &amp; credits</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"11\" height=\"11\" fill=\"currentColor\" viewBox=\"0 0 256 256\" class=\"shrink-0 text-zinc-600\"><path d=\"M204,64V168a12,12,0,0,1-24,0V93L72.49,200.49a12,12,0,0,1-17-17L163,76H88a12,12,0,0,1,0-24H192A12,12,0,0,1,204,64Z\"></path></svg></a></li></ul></details><details class=\"group\"><summary class=\"flex cursor-pointer list-none items-center justify-between px-3.5 py-3 [&amp;::-webkit-details-marker]:hidden\"><span class=\"flex items-center gap-2 text-[11px] font-mono uppercase tracking-wider text-zinc-300\"><span class=\"h-1.5 w-1.5 rounded-full bg-[#ff6600]\"></span>Governance<span class=\"text-zinc-600\">5</span></span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" fill=\"currentColor\" viewBox=\"0 0 256 256\" class=\"text-zinc-500 transition-transform duration-300 group-open:rotate-180\"><path d=\"M216.49,104.49l-80,80a12,12,0,0,1-17,0l-80-80a12,12,0,0,1,17-17L128,159l71.51-71.52a12,12,0,0,1,17,17Z\"></path></svg></summary><ul class=\"grid grid-cols-2 gap-1.5 px-2.5 pb-3\"><li><a class=\"flex h-full items-center justify-between gap-1 rounded-lg border border-[#272727] bg-[#1c1c1c] px-2.5 py-2 text-[12.5px] leading-tight text-zinc-300 active:border-[#ff6600]/60 active:text-white transition-colors\" href=\"/appeals\"><span>Independent appeals</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"11\" height=\"11\" fill=\"currentColor\" viewBox=\"0 0 256 256\" class=\"shrink-0 text-zinc-600\"><path d=\"M204,64V168a12,12,0,0,1-24,0V93L72.49,200.49a12,12,0,0,1-17-17L163,76H88a12,12,0,0,1,0-24H192A12,12,0,0,1,204,64Z\"></path></svg></a></li><li><a class=\"flex h-full items-center justify-between gap-1 rounded-lg border border-[#272727] bg-[#1c1c1c] px-2.5 py-2 text-[12.5px] leading-tight text-zinc-300 active:border-[#ff6600]/60 active:text-white transition-colors\" href=\"/report\"><span>Submit report</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"