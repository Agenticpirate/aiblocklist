\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-xl border border-[#272727] bg-[#000000] p-4 space-y-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"caption-3 font-mono text-[#ff6600] font-bold\\\",\\\"children\\\":\\\"GATE 2\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"title-3 text-white\\\",\\\"children\\\":\\\"Human Dual Review\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"body-6 text-zinc-400\\\",\\\"children\\\":\\\"Accounts with 10,000+ followers or verified organization credentials require two independent human reviewers before publication.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-xl border border-[#272727] bg-[#000000] p-4 space-y-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"caption-3 font-mono text-[#ff6600] font-bold\\\",\\\"children\\\":\\\"GATE 3\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"title-3 text-white\\\",\\\"children\\\":\\\"Zero Raw Text Archiving\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"body-6 text-zinc-400\\\",\\\"children\\\":\\\"To protect privacy and honor platform deletion rules, AIBlockList persists only canonical post URLs, platform post IDs, and SHA-256 hashes. Raw text is discarded.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-xl border border-[#272727] bg-[#000000] p-4 space-y-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"caption-3 font-mono text-[#ff6600] font-bold\\\",\\\"children\\\":\\\"GATE 4\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"title-3 text-white\\\",\\\"children\\\":\\\"Cryptographic Audit Chain\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"body-6 text-zinc-400\\\",\\\"children\\\":\\\"Every reviewer action, appeal status change, and policy update is immutably linked via an append-only SHA-256 hash chain publicly verifiable on the Transparency Ledger.\\\"}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-2xl border border-[#272727] bg-[#181818] p-4 sm:p-8 space-y-4 sm:space-y-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-1 border-b border-[#272727] pb-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"caption-4 uppercase text-[#ff6600] font-bold font-mono\\\",\\\"children\\\":\\\"Ecosystem Philosophy\\\"}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"heading-3 text-white\\\",\\\"children\\\":\\\"Noise vs. Substance \\u0026 The Course-Correction Doctrine\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-xl border border-[#272727] bg-[#111] p-5 space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"title-3 text-white\\\",\\\"children\\\":\\\"Is It Really About AI, or Low-Value Noise?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"body-5 text-zinc-300 font-sans leading-relaxed\\\",\\\"children\\\":\\\"Human attention is finite and expensive. When generative AI makes drafting text virtually free, creators are tempted to flood replies with automated affirmations simply to satisfy algorithmic velocity. Processing zero-value noise creates cognitive exhaustion.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"body-6 text-zinc-400 font-sans\\\",\\\"children\\\":[\\\"AIBlockList does not police authorship style or AI writing assistance. We strictly target\\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\" unsolicited programmatic noise loops\\\"}],\\\" that siphon human attention without contributing substance.\\\"]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-xl border border-[#272727] bg-[#111] p-5 space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"title-3 text-white\\\",\\\"children\\\":\\\"The Course-Correction Guarantee\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"body-5 text-zinc-300 font-sans leading-relaxed\\\",\\\"children\\\":\\\"Punitive mass blocking without transparency creates resentment and locks users into permanent exclusion. Because recommendation algorithms actively reward rapid replies, many creators unintentionally fall into bot-like patterns.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"body-6 text-zinc-400 font-sans\\\",\\\"children\\\":\\\"Everyone deserves a transparent chance to course-correct. That is why AIBlockList provides observable evidence links, pre-flight quality testing, and a free bio verification challenge with automated delisting.\\\"}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"e:[\\\"$\\\",\\\"$L14\\\",null,{\\\"children\\\":[\\\"$L15\\\",[\\\"$\\\",\\\"$L16\\\",null,{\\\"promise\\\":\\\"$@17\\\"}]]}]\\nf:[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[[\\\"$\\\",\\\"$L18\\\",null,{\\\"children\\\":\\\"$L19\\\"}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]],[\\\"$\\\",\\\"$L1a\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$1b\\\",null,{\\\"fallback\\\":null,\\\"children\\\":\\\"$L1c\\\"}]}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"11:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"body-5 mt-3 text-zinc-300\\\",\\\"children\\\":\\\"Distinguishes authentic community conversation from broadcast spray-and-pray farming. Always requires pairing with SIG-01 or SIG-02 to safeguard active human chatters.\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"12:[\\\"$\\\",\\\"div\\\",\\\"SIG-04\\\",{\\\"className\\\":\\\"rounded-2xl border border-[#272727] bg-[#181818] p-4 sm:p-6 transition-all hover:border-[#313131]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap items-start justify-between gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"cla