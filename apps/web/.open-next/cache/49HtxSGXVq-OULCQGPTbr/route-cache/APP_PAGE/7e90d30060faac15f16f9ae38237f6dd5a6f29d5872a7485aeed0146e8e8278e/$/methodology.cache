dence.\\\\\\\"\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4 sm:space-y-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"heading-3 text-white\\\",\\\"children\\\":\\\"The 5 Behavioral Signals\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"body-4 mt-1 text-zinc-400\\\",\\\"children\\\":\\\"Every classification requires repeatable behavioral proof observed across public thread URLs.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"SIG-01\\\",{\\\"className\\\":\\\"rounded-2xl border border-[#272727] bg-[#181818] p-4 sm:p-6 transition-all hover:border-[#313131]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap items-start justify-between gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"caption-3 rounded border border-[#ff6600]/40 bg-[#131209] px-2.5 py-1 font-mono font-bold text-[#ff6600]\\\",\\\"children\\\":\\\"SIG-01\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"title-2 text-white\\\",\\\"children\\\":\\\"Near-Duplicate Unsolicited Replies\\\"}]]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"caption-5 rounded border border-[#313131] bg-[#1f1f1f] px-2.5 py-0.5 font-mono text-zinc-400\\\",\\\"children\\\":\\\"Primary classification trigger.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-4 rounded-xl border border-[#272727] bg-[#000000] p-3 font-mono caption-4 text-[#ff6600]\\\",\\\"children\\\":[\\\"Threshold: \\\",\\\"3 or more replies with ≥ 0.90 cosine similarity across unrelated authors within 7 days\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"body-5 mt-3 text-zinc-300\\\",\\\"children\\\":\\\"Detects copy-paste spam loops while permitting genuine conversational consistency. Calculates TF-IDF and character n-gram cosine similarity across reply bodies.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"SIG-02\\\",{\\\"className\\\":\\\"rounded-2xl border border-[#272727] bg-[#181818] p-4 sm:p-6 transition-all hover:border-[#313131]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap items-start justify-between gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"caption-3 rounded border border-[#ff6600]/40 bg-[#131209] px-2.5 py-1 font-mono font-bold text-[#ff6600]\\\",\\\"children\\\":\\\"SIG-02\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"title-2 text-white\\\",\\\"children\\\":\\\"Structural Template Loops\\\"}]]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"caption-5 rounded border border-[#313131] bg-[#1f1f1f] px-2.5 py-0.5 font-mono text-zinc-400\\\",\\\"children\\\":\\\"Primary classification trigger.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-4 rounded-xl border border-[#272727] bg-[#000000] p-3 font-mono caption-4 text-[#ff6600]\\\",\\\"children\\\":[\\\"Threshold: \\\",\\\"5 or more replies in 14 days matching an identical structural clause skeleton\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"body-5 mt-3 text-zinc-300\\\",\\\"children\\\":\\\"Exposes synonym-rotated spambots that swap adjectives while keeping the exact pitch skeleton intact (e.g., 'Loved this insight! Check out my bio for more!').\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"SIG-03\\\",{\\\"className\\\":\\\"rounded-2xl border border-[#272727] bg-[#181818] p-4 sm:p-6 transition-all hover:border-[#313131]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap items-start justify-between gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3\\\",\\\