 clip-rule=\"evenodd\" d=\"M141.537 88.9883C140.71 88.5919 139.87 88.2104 139.019 87.8451C137.537 60.5382 122.616 44.905 97.5619 44.745C97.4484 44.7443 97.3355 44.7443 97.222 44.7443C82.2364 44.7443 69.7731 51.1409 62.102 62.7807L75.881 72.2328C81.6116 63.5383 90.6052 61.6848 97.2286 61.6848C97.3051 61.6848 97.3819 61.6848 97.4576 61.6855C105.707 61.7381 111.932 64.1366 115.961 68.814C118.893 72.2193 120.854 76.925 121.825 82.8638C114.511 81.6207 106.601 81.2385 98.145 81.7233C74.3247 83.0954 59.0111 96.9879 60.0396 116.292C60.5615 126.084 65.4397 134.508 73.775 140.011C80.8224 144.663 89.899 146.938 99.3323 146.423C111.79 145.74 121.563 140.987 128.381 132.296C133.559 125.696 136.834 117.143 138.28 106.366C144.217 109.949 148.617 114.664 151.047 120.332C155.179 129.967 155.42 145.8 142.501 158.708C131.182 170.016 117.576 174.908 97.0135 175.059C74.2042 174.89 56.9538 167.575 45.7381 153.317C35.2355 139.966 29.8077 120.682 29.6052 96C29.8077 71.3178 35.2355 52.0336 45.7381 38.6827C56.9538 24.4249 74.2039 17.11 97.0132 16.9405C119.988 17.1113 137.539 24.4614 149.184 38.788C154.894 45.8136 159.199 54.6488 162.037 64.9503L178.184 60.6422C174.744 47.9622 169.331 37.0357 161.965 27.974C147.036 9.60668 125.202 0.195148 97.0695 0H96.9569C68.8816 0.19447 47.2921 9.6418 32.7883 28.0793C19.8819 44.4864 13.2244 67.3157 13.0007 95.9325L13 96L13.0007 96.0675C13.2244 124.684 19.8819 147.514 32.7883 163.921C47.2921 182.358 68.8816 191.806 96.9569 192H97.0695C122.03 191.827 139.624 185.292 154.118 170.811C173.081 151.866 172.51 128.119 166.26 113.541C161.776 103.087 153.227 94.5962 141.537 88.9883ZM98.4405 129.507C88.0005 130.095 77.1544 125.409 76.6196 115.372C76.2232 107.93 81.9158 99.626 99.0812 98.6368C101.047 98.5234 102.976 98.468 104.871 98.468C111.106 98.468 116.939 99.0737 122.242 100.233C120.264 124.935 108.662 128.946 98.4405 129.507Z\"></path></svg><span>Threads</span></button></div></div><div class=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5\"><div class=\"relative flex-1\"><span class=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-500 font-bold\">@</span><input type=\"text\" placeholder=\"Enter handle (e.g. Agenticpirate or your username)\" class=\"w-full rounded-xl border border-[#313131] bg-[#0c0c0c] py-3 pl-9 pr-3 text-sm text-white placeholder-zinc-500 focus:border-[#ff6600] focus:outline-none focus:ring-1 focus:ring-[#ff6600]\" value=\"\"/></div><button type=\"submit\" disabled=\"\" class=\"button-md inline-flex items-center justify-center gap-2 rounded-xl bg-[#ff6600] px-6 py-3 font-bold text-black hover:bg-[#e55c00] active:scale-[0.98] transition-all disabled:opacity-50 cursor-pointer shadow-lg shadow-[#ff6600]/20 shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M232.49,215.51,185,168a92.12,92.12,0,1,0-17,17l47.53,47.54a12,12,0,0,0,17-17ZM44,112a68,68,0,1,1,68,68A68.07,68.07,0,0,1,44,112Z\"></path></svg><span>Analyze Account Health</span></button></div></form></div><div class=\"rounded-2xl border border-[#272727] bg-[#141414] p-6 sm:p-8 space-y-6 shadow-2xl font-mono\"><div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#272727] pb-5\"><div><span class=\"caption-4 uppercase text-[#ff6600] font-bold flex items-center gap-1.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M199,125.31l-49.88-18.39L130.69,57a19.92,19.92,0,0,0-37.38,0L74.92,106.92,25,125.31a19.92,19.92,0,0,0,0,37.38l49.88,18.39L93.31,231a19.92,19.92,0,0,0,37.38,0l18.39-49.88L199,162.69a19.92,19.92,0,0,0,0-37.38Zm-63.38,35.16a12,12,0,0,0-7.11,7.11L112,212.28l-16.47-44.7a12,12,0,0,0-7.11-7.11L43.72,144l44.7-16.47a12,12,0,0,0,7.11-7.11L112,75.72l16.47,44.7a12,12,0,0,0,7.11,7.11L180.28,144ZM140,40a12,12,0,0,1,12-12h12V16a12,12,0,0,1,24,0V28h12a12,12,0,0,1,0,24H188V64a12,12,0,0,1-24,0V52H152A12,12,0,0,1,140,40ZM252,88a12,12,0,0,1-12,12h-4v4a12,12,0,0,1-24,0v-4h-4a12,12,0,0,1,0-24h4V72a12,12,0,0,1,24,0v4h4A12,12,0,0,1,252,88Z\"></path></svg><span>Interactive Simulator</span></span><h3 class=\"title-2 text-white mt-1\">Pre-Flight Reply &amp; Post Quality Evaluator</h3><p class=\"caption-4 text-zinc-400 mt-1 font-sans\">Test your draft before posting to predict algorithmic deboosting risk and verify conversational value.</p></div><span class=\"caption-5 uppercase rounded bg-[#272727] px-2.5 py-1 text-zinc-400 self-start sm:self-center font-bold\">Zero Data Logging</span></div><form class=\"space-y-4\"><div><label for=\"draft-reply\" class=\"caption-4 block text-zinc-300 font-bold mb-2\">Paste your draft reply or post:</label><textarea id=\"draft-reply\" rows=\"4\" placeholder=\"e.g. In our distributed Postgres setup, we encountered the same write lock issue. What worked was partitioning by tenant_id before scaling replicas...\" class=\"w-full rounded-xl border border-[#313131] bg-[#0c0c0c] p-3 text-sm text-white placeholder-zinc-500 focus:border-[#ff6600] focus:outline-none focus:ring-1 focus:ring-[#ff6600] leading-relaxed font-sans\"></textarea></div><div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1\"><div class=\"text-xs text-zinc-500 font-sans\">Evaluates against 𝕏&#x27;s known <code class=\"text-zinc-300\">ReplyDeboosting</code> heuristics, formulaic bot patterns, and value thresholds.</div><button type=\"submit\" disabled=\"\" class=\"button-md inline-flex items-center justify-center gap-2 rounded-xl bg-[#ff6600] px-5 py-2.5 text-xs font-bold text-black hover:bg-[#e55c00] active:scale-[0.98] transition-all disabled:opacity-50 cursor-pointer shadow-lg shadow-[#ff6600]/20 shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M199,125.31l-49.88-18.39L130.69,57a19.92,19.92,0,0,0-37.38,0L74.92,106.92,25,125.31a19.92,19.92,0,0,0,0,37.38l49.88,18.39L93.31,231a19.92,19.92,0,0,0,37.38,0l18.39-49.88L199,162.69a19.92,19.92,0,0,0,0-37.38Zm-63.38,35.16a12,12,0,0,0-7.11,7.11L112,212.28l-16.47-44.7a12,12,0,0,0-7.11-7.11L43.72,144l44.7-16.47a12,12,0,0,0,7.11-7.11L112,75.72l16.47,44.7a12,12,0,0,0,7.11,7.11L180.28,144ZM140,40a12,12,0,0,1,12-12h12V16a12,12,0,0,1,24,0V28h12a12,12,0,0,1,0,24H188V64a12,12,0,0,1-24,0V52H152A12,12,0,0,1,140,40ZM252,88a12,12,0,0,1-12,12h-4v4a12,12,0,0,1-24,0v-4h-4a12,12,0,0,1,0-24h4V72a12,12,0,0,1,24,0v4h4A12,12,0,0,1,252,88Z\"></path></svg><span>Run Pre-Flight Analysis</span></button></div></form></div><div class=\"rounded-2xl border border-[#272727] bg-[#181818] p-6 sm:p-8 space-y-6\"><div class=\"space-y-1 border-b border-[#272727] pb-4\"><span class=\"caption-4 uppercase text-[#ff6600] font-bold\">Actionable Strategic Diagnostics</span><h2 class=\"heading-3 text-white\">Why Reach Gets Buried &amp; How to Course-Correct</h2><p class=\"caption-4 text-zinc-400 font-sans\">Platforms rarely explain why your engagement drops. Here is the operational reality of how algorithmic downranking works and how you can rehabilitate your account.</p></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"><div class=\"rounded-xl border border-[#272727] bg-[#121212] p-5 space-y-3\"><div class=\"flex items-center gap-2 text-[#ff6600]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M128,20A108,108,0,1,0,236,128,108.12,108.12,0,0,0,128,20Zm0,192a84,84,0,1,1,84-84A84.09,84.09,0,0,1,128,212Zm-12-80V80a12,12,0,0,1,24,0v52a12,12,0,0,1-24,0Zm28,40a16,16,0,1,1-16-16A16,16,0,0,1,144,172Z\"></path></svg><h3 class=\"title-3 text-white\">&quot;Why did my post only reach 15 people with 1,500 followers?&quot;</h3></div><p class=\"body-5 text-zinc-300 font-sans leading-relaxed\">When an account triggers excessive blocks, mutes, or automated bot flags, platforms apply the <strong>DoNotAmplify</strong> label. Instead of showing your post to your follower network and the &quot;For You&quot; feed, delivery is restricted exclusively to direct profile visitors and users with notifications turned on.</p><div class=\"rounded-lg border border-[#222] bg-[#0c0c0c] p-2.5 text-xs text-zinc-400 font-mono\">💡 <strong>Actionable Tip:</strong> Reduce output frequency. Post 1 high-substance post with data or unique insight every 48h rather than 10 rapid posts.</div></div><div class=\"rounded-xl border border-[#272727] bg-[#121212] p-5 space-y-3\"><div class=\"flex items-center gap-2 text-[#ff6600]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M128,20A108,108,0,1,0,236,128,108.12,108.12,0,0,0,128,20Zm0,192a84,84,0,1,1,84-84A84.09,84.09,0,0,1,128,212Zm-12-80V80a12,12,0,0,1,24,0v52a12,12,0,0,1-24,0Zm28,40a16,16,0,1,1-16-16A16,16,0,0,1,144,172Z\"></path></svg><h3 class=\"title-3 text-white\">&quot;Why did my reply get buried behind &#x27;Show more replies&#x27;?&quot;</h3></div><p class=\"body-5 text-zinc-300 font-sans leading-relaxed\">Heuristic filters penalize formulaic affirmations (e.g. &quot;Great point!&quot;, &quot;Totally agree&quot;) and rapid-fire replies to non-followers. The algorithm classifies short generic responses as low-value noise and downranks them below human conversation turns.</p><div class=\"rounded-lg border border-[#222] bg-[#0c0c0c] p-2.5 text-xs text-zinc-400 font-mono\">💡 <strong>Actionable Tip:</strong> Never reply with just agreement. Ask a specific question, share a technical anecdote, or provide counter-evidence.</div></div><div class=\"rounded-xl border border-[#272727] bg-[#121212] p-5 space-y-3\"><div class=\"flex items-center gap-2 text-emerald-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M176.49,95.51a12,12,0,0,1,0,17l-56,56a12,12,0,0,1-17,0l-24-24a12,12,0,1,1,17-17L112,143l47.51-47.52A12,12,0,0,1,176.49,95.51ZM236,128A108,108,0,1,1,128,20,108.12,108.12,0,0,1,236,128Zm-24,0a84,84,0,1,0-84,84A84.09,84.09,0,0,0,212,128Z\"></path></svg><h3 class=\"title-3 text-white\">Noise vs. Substance: The Cost of Free Bot Generation</h3></div><p class=\"body-5 text-zinc-300 font-sans leading-relaxed\">Human attention is expensive. When LLMs make text generation virtually free, users flood replies to farm engagement. Quality is not about whether an LLM assisted your grammar—it is about whether the output provides <strong>genuine substance or informational pollution</strong>.</p><div class=\"rounded-lg border border-[#222] bg-[#0c0c0c] p-2.5 text-xs text-zinc-400 font-mono\">💡 <strong>Core Principle:</strong> AIBlockList never bans AI grammar polishing or ESL translation. We only target unsolicited repetitive spam loops.</div></div><div class=\"rounded-xl border border-[#272727] bg-[#121212] p-5 space-y-3\"><div class=\"flex items-center gap-2 text-[#ff6600]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M71.76,148H31.7a12,12,0,1,1,0-24H65.33l12.45-18.66a12,12,0,0,1,20,0l22,33,6-9a12,12,0,0,1,10-5.34h24a12,12,0,1,1,0,24h-17.6l-12.46,18.66a12,12,0,0,1-20,0l-22-33-6,9A12,12,0,0,1,71.76,148ZM177.91,36c-20.12,0-38,7.93-50.07,21.56C115.74,43.93,97.89,36,77.76,36A66,66,0,0,0,12.07,94.68,12,12,0,0,0,36,97.32,42,42,0,0,1,77.76,60c17.83,0,32.75,9.4,38.95,24.54a12,12,0,0,0,22.25,0C145.16,69.4,160.08,60,177.91,60A42.08,42.08,0,0,1,220,102c0,29.42-25.86,57.77-47.56,76.36a329,329,0,0,1-44.58,31.81c-10.87-6.45-35.37-22-56.51-42.73a12,12,0,1,0-16.84,17.12c30.39,29.81,66.15,49.2,67.66,50a12.06,12.06,0,0,0,11.39,0C138,232.14,244,174.34,244,102A66.12,66.12,0,0,0,177.91,36Z\"></path></svg><h3 class=\"title-3 text-white\">The Perverse Algorithmic Incentive &amp; The Exit Route</h3></div><p class=\"body-5 text-zinc-300 font-sans leading-relaxed\">Platforms inadvertently incentivize spam by penalizing posts that don&#x27;t reply immediately. Creators resort to automated extensions, which eventually causes their accounts to get shadowbanned or mass-blocked.</p><div class=\"rounded-lg border border-[#222] bg-[#0c0c0c] p-2.5 text-xs text-zinc-400 font-mono\">💡 <strong>Course-Correction Route:</strong> Everyone deserves a second chance. 14–30 days of authentic human-only replies resets algorithmic safety scores.</div></div></div></div><div class=\"space-y-6\"><div class=\"rounded-2xl border border-[#ff6600]/40 bg-gradient-to-b from-[#1c140e] to-[#0f0a07] p-5 sm:p-6 shadow-xl\"><div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\"><div class=\"space-y-2 max-w-2xl\"><div class=\"inline-flex items-center gap-2 rounded-full border border-[#ff6600]/40 bg-[#261305] px-3 py-1 text-xs font-mono text-[#ff6600]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" fill=\"currentColor\" viewBox=\"0 0 256 256\" class=\"animate-pulse\"><path d=\"M213.85,125.46l-112,120a8,8,0,0,1-13.69-7l14.66-73.33L45.19,143.49a8,8,0,0,1-3-13l112-120a8,8,0,0,1,13.69,7L153.18,90.9l57.63,21.61a8,8,0,0,1,3,12.95Z\"></path></svg><span>𝕏 Open-Source Algorithm Intelligence Update</span></div><h2 class=\"heading-3 text-white\">The &quot;Fast Reply Spam&quot; &amp; Reach Survival Guide</h2><p class=\"body-4 text-zinc-300 font-sans leading-relaxed\">𝕏&#x27;s open-source recommendation repository updated its automated spam labeling engine. Small accounts firing off replies in seconds under posts that didn&#x27;t tag them are receiving a <strong>30-day silent notification suppression</strong>. Here is the verified breakdown and scoring matrix.</p></div><div class=\"flex flex-wrap items-center gap-2\"><span class=\"caption-5 font-mono px-2.5 py-1 rounded-md border border-[#333] bg-[#1a1a1a] text-zinc-400\">Source: x/algorithm</span></div></div><div class=\"flex items-center gap-2 border-t border-[#331c0e] mt-6 pt-4 overflow-x-auto\"><button class=\"button-xsm rounded-lg px-3 py-1.5 font-mono text-xs whitespace-nowrap transition-all cursor-pointer bg-[#ff6600] text-black font-bold\">Breaking Update: Fast Reply Label</button><button class=\"button-xsm rounded-lg px-3 py-1.5 font-mono text-xs whitespace-nowrap transition-all cursor-pointer border border-[#333] bg-[#121212] text-zinc-400 hover:text-white\">Algorithm Scoring Matrix</button><button class=\"button-xsm rounded-lg px-3 py-1.5 font-mono text-xs whitespace-nowrap transition-all cursor-pointer border border-[#333] bg-[#121212] text-zinc-400 hover:text-white\">16 Things You Should Do</button><button class=\"button-xsm rounded-lg px-3 py-1.5 font-mono text-xs whitespace-nowrap transition-all cursor-pointer border border-[#333] bg-[#121212] text-zinc-400 hover:text-white\">20 Things You Must Avoid</button></div></div><div class=\"space-y-4\"><div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\"><div class=\"rounded-xl border border-[#272727] bg-[#141414] p-5 space-y-2\"><span class=\"text-[11px] font-mono uppercase text-[#ff6600] font-bold block\">1. The Label &amp; Penalty</span><h3 class=\"title-3 text-white\">30-Day Silent Penalty</h3><p class=\"text-xs text-zinc-300 font-sans leading-relaxed\">The <em>&quot;fast reply spam&quot;</em> label attaches to the specific reply for <strong>30 days</strong>. The recipient receives zero notification (even if they follow you), and the reply is completely purged from &quot;For You&quot;.</p></div><div class=\"rounded-xl border border-[#272727] bg-[#141414] p-5 space-y-2\"><span class=\"text-[11px] font-mono uppercase text-[#ff6600] font-bold block\">2. Who It Impacts</span><h3 class=\"title-3 text-white\">Targeted at Small Accounts</h3><p class=\"text-xs text-zinc-300 font-sans leading-relaxed\">Accounts above a secret follower threshold and high historical trust scores bypass this check. <strong>Small and growing accounts bear the brunt</strong> of false-positive spam suppression.</p></div><div class=\"rounded-xl border border-[#272727] bg-[#141414] p-5 space-y-2\"><span class=\"text-[11px] font-mono uppercase text-[#ff6600] font-bold block\">3. The New Exemption</span><h3 class=\"title-3 text-white\">Posts That Tagged You</h3><p class=\"text-xs text-zinc-300 font-sans leading-relaxed\">Before applying the label, 𝕏&#x27;s code now parses the root post. If that post explicitly typed your @handle, <strong>all automated spam labels (&quot;llm slop&quot; included) are skipped</strong>.</p></div></div><div class=\"rounded-xl border border-[#272727] bg-[#111] p-4 text-xs font-mono text-zinc-300 space-y-1.5\"><span class=\"text-[#ff6600] font-bold uppercase text-[11px] block\">Core Algorithmic Takeaway:</span><p class=\"font-sans text-sm text-zinc-200\">Never fire off generic, 3-second replies (&quot;great post!&quot;, &quot;interesting perspective!&quot;) under viral accounts. Take at least 20–30 seconds to read the post and write a genuine, contextual reply.</p></div></div></div><div class=\"rounded-2xl border border-[#272727] bg-[#181818] p-6 sm:p-8 space-y-6\"><div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#272727] pb-5\"><div class=\"space-y-1\"><span class=\"caption-4 uppercase text-[#ff6600] font-bold\">Official Platform Transparency Feature</span><h2 class=\"heading-3 text-white\">𝕏 Official &quot;Under the Hood&quot; Transparency Report</h2></div><div class=\"flex items-center gap-2\"><a href=\"https://x.com/i/jf/under_the_hood/report\" target=\"_blank\" rel=\"noreferrer\" class=\"button-sm inline-flex items-center gap-1.5 rounded-lg bg-[#ff6600] px-3.5 py-2 font-bold text-black hover:bg-[#e55c00] transition-colors shrink-0\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" class=\"w-3.5 h-3.5 shrink-0 transition-transform duration-300 drop-shadow-[0_0_4px_rgba(255,255,255,0.7)]\" aria-label=\"X logo\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"></path></svg><span>Launch Under The Hood ↗</span></a></div></div><div class=\"space-y-4 body-4 text-zinc-300 font-sans leading-relaxed\"><p>𝕏 has officially released <strong>Under the Hood</strong> (available at<!-- --> <a href=\"https://x.com/i/jf/under_the_hood\" target=\"_blank\" rel=\"noreferrer\" class=\"font-mono text-[#ff6600] hover:underline\">x.com/i/jf/under_the_hood</a>). It is 𝕏&#x27;s internal algorithmic ledger that tells creators explicitly whether their visibility was limited by automated systems or legal demands over the past month.</p><h3 class=\"title-3 text-white font-mono pt-2\">Internal Flags Applied by 𝕏 Algorithms:</h3><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-3 font-mono text-xs\"><div class=\"rounded-xl border border-[#272727] bg-[#121212] p-4 space-y-1.5\"><strong class=\"text-[#ff6600] text-sm block\">DoNotAmplify</strong><p class=\"text-zinc-400 font-sans\">Prevents your posts from being recommended in the &quot;For You&quot; timeline to non-followers. Typically triggered by repetitive posting patterns, hashtag overload, or high block rates.</p></div><div class=\"rounded-xl border border-[#272727] bg-[#121212] p-4 space-y-1.5\"><strong class=\"text-[#ff6600] text-sm block\">SpamHighRecall</strong><p class=\"text-zinc-400 font-sans\">Aggressive spam filter tag applied when heuristics detect copy-paste replies, rapid automated mentions, or programmatic bot behavior.</p></div><div class=\"rounded-xl border border-[#272727] bg-[#121212] p-4 space-y-1.5\"><strong class=\"text-[#ff6600] text-sm block\">ReplyDeboosting</strong><p class=\"text-zinc-400 font-sans\">Suppresses your replies to the bottom of conversation threads, frequently placing them behind the &quot;Show probable spam / more replies&quot; accordion.</p></div><div class=\"rounded-xl border border-[#272727] bg-[#121212] p-4 space-y-1.5\"><strong class=\"text-[#ff6600] text-sm block\">SearchSuggestionBlacklist</strong><p class=\"text-zinc-400 font-sans\">Excludes your profile handle and tweets from appearing in the universal search typeahead box unless the exact handle is fully typed out.</p></div></div><div class=\"rounded-xl border border-[#272727] bg-[#0d0d0d] p-4 space-y-2 text-xs font-mono text-zinc-400\"><span class=\"text-zinc-300 font-bold block uppercase text-[11px]\">How to view your monthly JSON audit on 𝕏:</span><p>1. Open a browser and log into your account on 𝕏.</p><p>2. Navigate to: <code class=\"text-[#ff6600]\">https://x.com/i/jf/under_the_hood/report</code>.</p><p>3. If your account is at least 1 year old with 10+ posts in the prior month, 𝕏 displays your complete breakdown of active labels and government compliance actions.</p></div></div></div><div class=\"rounded-2xl border border-[#272727] bg-[#181818] p-6 sm:p-8 space-y-4\"><h2 class=\"heading-3 text-white flex items-center gap-2\"><svg viewBox=\"0 0 192 192\" fill=\"currentColor\" class=\"w-5 h-5 text-white shrink-0 transition-transform duration-300 drop-shadow-[0_0_4px_rgba(255,255,255,0.7)]\" aria-label=\"Threads logo\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M141.537 88.9883C140.71 88.5919 139.87 88.2104 139.019 87.8451C137.537 60.5382 122.616 44.905 97.5619 44.745C97.4484 44.7443 97.3355 44.7443 97.222 44.7443C82.2364 44.7443 69.7731 51.1409 62.102 62.7807L75.881 72.2328C81.6116 63.5383 90.6052 61.6848 97.2286 61.6848C97.3051 61.6848 97.3819 61.6848 97.4576 61.6855C105.707 61.7381 111.932 64.1366 115.961 68.814C118.893 72.2193 120.854 76.925 121.825 82.8638C114.511 81.6207 106.601 81.2385 98.145 81.7233C74.3247 83.0954 59.0111 96.9879 60.0396 116.292C60.5615 126.084 65.4397 134.508 73.775 140.011C80.8224 144.663 89.899 146.938 99.3323 146.423C111.79 145.74 121.563 140.987 128.381 132.296C133.559 125.696 136.834 117.143 138.28 106.366C144.217 109.949 148.617 114.664 151.047 120.332C155.179 129.967 155.42 145.8 142.501 158.708C131.182 170.016 117.576 174.908 97.0135 175.059C74.2042 174.89 56.9538 167.575 45.7381 153.317C35.2355 139.966 29.8077 120.682 29.6052 96C29.8077 71.3178 35.2355 52.0336 45.7381 38.6827C56.9538 24.4249 74.2039 17.11 97.0132 16.9405C119.988 17.1113 137.539 24.4614 149.184 38.788C154.894 45.8136 159.199 54.6488 162.037 64.9503L178.184 60.6422C174.744 47.9622 169.331 37.0357 161.965 27.974C147.036 9.60668 125.202 0.195148 97.0695 0H96.9569C68.8816 0.19447 47.2921 9.6418 32.7883 28.0793C19.8819 44.4864 13.2244 67.3157 13.0007 95.9325L13 96L13.0007 96.0675C13.2244 124.684 19.8819 147.514 32.7883 163.921C47.2921 182.358 68.8816 191.806 96.9569 192H97.0695C122.03 191.827 139.624 185.292 154.118 170.811C173.081 151.866 172.51 128.119 166.26 113.541C161.776 103.087 153.227 94.5962 141.537 88.9883ZM98.4405 129.507C88.0005 130.095 77.1544 125.409 76.6196 115.372C76.2232 107.93 81.9158 99.626 99.0812 98.6368C101.047 98.5234 102.976 98.468 104.871 98.468C111.106 98.468 116.939 99.0737 122.242 100.233C120.264 124.935 108.662 128.946 98.4405 129.507Z\"></path></svg><span>Meta Threads: In-App Account Status Checker</span></h2><p class=\"body-4 text-zinc-300 font-sans leading-relaxed\">Meta Threads shares account integrity infrastructure with Instagram. You can inspect your real-time recommendation and feature restrictions natively:</p><div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs\"><div class=\"rounded-xl border border-[#272727] bg-[#121212] p-3.5 space-y-1\"><span class=\"text-white font-bold block\">1. Open Settings</span><p class=\"text-zinc-400 font-sans\">Go to your Profile → Menu (top right) → Settings.</p></div><div class=\"rounded-xl border border-[#272727] bg-[#121212] p-3.5 space-y-1\"><span class=\"text-white font-bold block\">2. Select Help</span><p class=\"text-zinc-400 font-sans\">Tap <em>Help</em> → <em>Account Status</em>.</p></div><div class=\"rounded-xl border border-[#272727] bg-[#121212] p-3.5 space-y-1\"><span class=\"text-white font-bold block\">3. Verify Standing</span><p class=\"text-zinc-400 font-sans\">Review &quot;Removed Content&quot; and &quot;Features you can&#x27;t use&quot;.</p></div></div></div></div><!--$--><!--/$--></main><div class=\"mx-auto max-w-6xl px-3 sm:px-6 lg:px-8 mt-8 sm:mt-10 pb-6 sm:pb-8\"><footer class=\"relative rounded-2xl border border-[#272727] bg-[#181818] px-4 py-6 sm:px-8 sm:py-10\"><button type=\"button\" aria-label=\"Scroll to top\" class=\"absolute top-5 right-5 sm:top-7 sm:right-7 rounded-xl border border-[#313131] bg-[#1F1F1F] p-2 text-zinc-400 hover:border-[#ff6600]/60 hover:text-white transition-colors duration-300 cursor-pointer\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M216.49,168.49a12,12,0,0,1-17,0L128,97,56.49,168.49a12,12,0,0,1-17-17l80-80a12,12,0,0,1,17,0l80,80A12,12,0,0,1,216.49,168.49Z\"></path></svg></button><div class=\"flex flex-col md:flex-row justify-between items-start gap-6 md:gap-10 mb-6 md:mb-8 pr-10 md:pr-0\"><div class=\"flex flex-col items-start max-w-sm space-y-2.5\"><a class=\"inline-flex items-center gap-2.5 group\" href=\"/\"><div class=\"flex h-9 w-9 items-center justify-center rounded-xl border border-[#313131] bg-[#000000] p-1.5 group-hover:border-[#ff6600]/60 transition-colors duration-300\"><img alt=\"AIBlockList Logo\" loading=\"lazy\" width=\"32\" height=\"32\" decoding=\"async\" data-nimg=\"1\" class=\"h-full w-full object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Flogo.png&amp;w=32&amp;q=75 1x, /_next/image?url=%2Flogo.png&amp;w=64&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo.png&amp;w=64&amp;q=75\"/></div><span class=\"title-2 font-mono text-white tracking-tight\">AIBlockList<span class=\"text-[#ff6600]\">.</span></span></a><p class=\"body-6 text-zinc-400 text-pretty\">Independent, open source trust infrastructure separating automated reply spam from authentic human speech across 𝕏 and Threads.</p><div class=\"inline-flex items-center gap-2 rounded-lg border border-[#272727] bg-[#000000] px-2.5 py-1 caption-5 font-mono text-zinc-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" fill=\"currentColor\" viewBox=\"0 0 256 256\" class=\"text-emerald-400 shrink-0\"><path d=\"M208,36H48A20,20,0,0,0,28,56v56c0,54.29,26.32,87.22,48.4,105.29,23.71,19.39,47.44,26,48.44,26.29a12.1,12.1,0,0,0,6.32,0c1-.28,24.73-6.9,48.44-26.29,22.08-18.07,48.4-51,48.4-105.29V56A20,20,0,0,0,208,36Zm-4,76c0,35.71-13.09,64.69-38.91,86.15A126.28,126.28,0,0,1,128,219.38a126.14,126.14,0,0,1-37.09-21.23C65.09,176.69,52,147.71,52,112V60H204ZM79.51,144.49a12,12,0,1,1,17-17L112,143l47.51-47.52a12,12,0,0,1,17,17l-56,56a12,12,0,0,1-17,0Z\"></path></svg><span>Apache 2.0 · ODC-By 1.0 · Policy v1.0.0</span></div></div><div class=\"grid grid-cols-2 sm:grid-cols-3 gap-6 sm:gap-8 md:gap-10 text-sm w-full md:w-auto\"><div class=\"flex flex-col items-start\"><h3 class=\"mb-2.5 text-[10px] font-mono uppercase tracking-wider text-zinc-500\">Platform</h3><ul class=\"space-y-1.5 text-zinc-400\"><li><a class=\"relative inline-block body-6 text-zinc-400 hover:text-white transition-colors duration-300 group\" href=\"/\"><span>Intelligence feed</span><span class=\"absolute left-0 -bottom-[1px] h-[1px] w-0 bg-[#ff6600] transition-all duration-300 group-hover:w-full\"></span></a></li><li><a class=\"relative inline-block body-6 text-zinc-400 hover:text-white transition-colors duration-300 group\" href=\"/directory\"><span>Account directory</span><span class=\"absolute left-0 -bottom-[1px] h-[1px] w-0 bg-[#ff6600] transition-all duration-300 group-hover:w-full\"></span></a></li><li><a class=\"relative inline-block body-6 text-zinc-400 hover:text-white transition-colors duration-300 group\" href=\"/account-health\"><span>Account health</span><span class=\"absolute left-0 -bottom-[1px] h-[1px] w-0 bg-[#ff6600] transition-all duration-300 group-hover:w-full\"></span></a></li><li><a class=\"relative inline-block body-6 text-zinc-400 hover:text-white transition-colors duration-300 group\" href=\"/api-docs\"><span>Developer API</span><span class=\"absolute left-0 -bottom-[1px] h-[1px] w-0 bg-[#ff6600] transition-all duration-300 group-hover:w-full\"></span></a></li></ul></div><div class=\"flex flex-col items-start\"><h3 class=\"mb-2.5 text-[10px] font-mono uppercase tracking-wider text-zinc-500\">Resources</h3><ul class=\"space-y-1.5 text-zinc-400\"><li><a class=\"relative inline-block body-6 text-zinc-400 hover:text-white transition-colors duration-300 group\" href=\"/methodology\"><span>Methodology &amp; signals</span><span class=\"absolute left-0 -bottom-[1px] h-[1px] w-0 bg-[#ff6600] transition-all duration-300 group-hover:w-full\"></span></a></li><li><a class=\"relative inline-block body-6 text-zinc-400 hover:text-white transition-colors duration-300 group\" href=\"/transparency\"><span>Transparency ledger</span><span class=\"absolute left-0 -bottom-[1px] h-[1px] w-0 bg-[#ff6600] transition-all duration-300 group-hover:w-full\"></span></a></li><li><a class=\"relative inline-block body-6 text-zinc-400 hover:text-white transition-colors duration-300 group\" href=\"/about\"><span>About &amp; credits</span><span class=\"absolute left-0 -bottom-[1px] h-[1px] w-0 bg-[#ff6600] transition-all duration-300 group-hover:w-full\"></span></a></li></ul></div><div class=\"flex flex-col items-start\"><h3 class=\"mb-2.5 text-[10px] font-mono uppercase tracking-wider text-zinc-500\">Governance</h3><ul class=\"space-y-1.5 text-zinc-400\"><li><a class=\"relative inline-block body-6 text-zinc-400 hover:text-white transition-colors duration-300 group\" href=\"/appeals\"><span>Independent appeals</span><span class=\"absolute left-0 -bottom-[1px] h-[1px] w-0 bg-[#ff6600] transition-all duration-300 group-hover:w-full\"></span></a></li><li><a class=\"relative inline-block body-6 text-zinc-400 hover:text-white transition-colors duration-300 group\" href=\"/report\"><span>Submit report</span><span class=\"absolute left-0 -bottom-[1px] h-[1px] w-0 bg-[#ff6600] transition-all duration-300 group-hover:w-full\"></span></a></li><li><a class=\"relative inline-block body-6 text-zinc-400 hover:text