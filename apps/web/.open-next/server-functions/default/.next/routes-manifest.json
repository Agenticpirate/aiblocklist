{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/docs",
        "destination": "http://127.0.0.1:8000/docs",
        "regex": "^/docs(?:/)?$"
      },
      {
        "source": "/openapi.json",
        "destination": "http://127.0.0.1:8000/openapi.json",
        "regex": "^/openapi\\.json(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/accounts/[platform]/[username]",
      "regex": "^/accounts/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPplatform": "nxtPplatform",
        "nxtPusername": "nxtPusername"
      },
      "namedRegex": "^/accounts/(?<nxtPplatform>[^/]+?)/(?<nxtPusername>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v1/[...path]",
      "regex": "^/api/v1/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/v1/(?<nxtPpath>.+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/account-health",
      "regex": "^/account\\-health(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/account\\-health(?:/)?$"
    },
    {
      "page": "/api-docs",
      "regex": "^/api\\-docs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api\\-docs(?:/)?$"
    },
    {
      "page": "/appeals",
      "regex": "^/appeals(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/appeals(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/directory",
      "regex": "^/directory(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/directory(?:/)?$"
    },
    {
      "page": "/extension",
      "regex": "^/extension(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/extension(?:/)?$"
    },
    {
      "page": "/icon.png",
      "regex": "^/icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.png(?:/)?$"
    },
    {
      "page": "/methodology",
      "regex": "^/methodology(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/methodology(?:/)?$"
    },
    {
      "page": "/privacy",
      "regex": "^/privacy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy(?:/)?$"
    },
    {
      "page": "/report",
      "regex": "^/report(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/report(?:/)?$"
    },
    {
      "page": "/terms",
      "regex": "^/terms(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/terms(?:/)?$"
    },
    {
      "page": "/transparency",
      "regex": "^/transparency(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/transparency(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}