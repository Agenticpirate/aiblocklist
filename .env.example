# AIBlockList.com Environment Configuration Example
# Never commit real credentials or secrets to version control.

APP_ENV=local
APP_SECRET_KEY=change-me-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database: PostgreSQL 16+ in Docker/Production; local SQLite fallback for quick local dev
DATABASE_URL=postgresql+asyncpg://aibl_app_rw:aibl_dev_password@postgres:5432/aiblocklist
PUBLIC_READ_DATABASE_URL=postgresql+asyncpg://aibl_public_ro:aibl_ro_password@postgres:5432/aiblocklist
VALKEY_URL=redis://valkey:6379/0

# Authentication & OAuth
AUTH_PROVIDER=github
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Official X API v2 (Targeted verification only; hard budget ceiling)
X_API_CLIENT_ID=
X_API_CLIENT_SECRET=
X_API_BEARER_TOKEN=
X_API_BUDGET_CAP_USD=100.00
X_API_UNIT_COST_POST_READ=0.005
X_API_UNIT_COST_USER_READ=0.010

# Object Storage (Cloudflare R2 in prod; MinIO locally)
S3_ENDPOINT_URL=http://minio:9000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=aiblocklist-snapshots

# Email & Observability
EMAIL_PROVIDER=console
EMAIL_API_KEY=
SENTRY_DSN=

# Configurable Policy & Governance Limits
API_RATE_LIMIT_ANONYMOUS=60
API_RATE_LIMIT_REGISTERED=600
REPORT_RATE_LIMIT_HOURLY_IP=20
BRIGADING_BURST_COUNT=5
BRIGADING_BURST_WINDOW_MINUTES=15
MODERATION_HIGH_IMPACT_THRESHOLD=10000
ACCOUNT_REVIEW_EXPIRY_DAYS=180
APPEAL_SLA_BUSINESS_DAYS=7
APPEAL_COOLDOWN_DAYS=14
EXTERNAL_SYNC_ANOMALY_RATIO=0.10

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
